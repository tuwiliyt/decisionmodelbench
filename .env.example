# ==============================================================================
# Configuration file for Decision Models & Heavyweight LLM Benchmark
# ==============================================================================

# API Key for TypeSafe Jev Cloud SaaS (https://typesafe.ai)
# Biarkan kosong jika hanya ingin menggunakan model lokal (Laya, OpenJev, Kev).
JEV_API_KEY=""

# Endpoint URL for TypeSafe Jev
JEV_ENDPOINT="https://api.typesafe.ai/v1/systemone"

# Directory where Heavyweight LLM models (.gguf) are stored
MODELS_DIR="/root/models"

# Port for FastAPI Web Dashboard
PORT=7860
